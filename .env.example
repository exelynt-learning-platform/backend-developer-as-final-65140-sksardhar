# Copy this file to .env (or export these as real environment variables) before running the app.

# --- Database ---
# For PostgreSQL:
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# For MySQL, use these instead:
# DB_URL=jdbc:mysql://localhost:3306/booking_db?useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- JPA ---
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Must be a long, random, base64-safe string (>= 32 bytes) in real environments.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=3600000

# --- Server ---
SERVER_PORT=8080
